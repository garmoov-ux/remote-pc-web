# ============================================================================
# 원격플러그인 피시 (UNPLUG 원격 PC방) 웹 포털 — 환경변수 표준 템플릿 (.env.example)
# 실제 운영 시 본 파일을 .env 로 복사하여 사용하며, .env 파일은 Git에 커밋하지 않습니다.
# ============================================================================

# [1] 서비스 및 사업자 마스터 정보 설정
APP_NAME="원격플러그인 피시 원격 PC방"
BRAND_SHORT_NAME="원격플러그인 피시"
COMPANY_NAME="언플러그"
COMPANY_CEO="차수빈"
COMPANY_BIZ_NO="240-18-02372"
COMPANY_TELECOM_NO="제 2025-김해장유-0356 호"
COMPANY_ADDRESS="경상남도 김해시 대청로 210번길 24"
CS_PHONE="010-3470-8716"
CS_EMAIL="pueen123@naver.com"
CS_KAKAO_URL="https://pf.kakao.com/_Ypsan"
ANYDESK_DOWNLOAD_URL="https://anydesk.com/ko/downloads"

# [2] 접속기 설치 패키지 배포 설정
CLIENT_INSTALLER_FILENAME="unplug_setup.exe"
CLIENT_INSTALLER_VERSION="2.6.0"
CLIENT_INSTALLER_FALLBACK_URL="https://unplug.co.kr/down/unplug_setup.exe"

# [3] 백엔드 서버 구동 설정
APP_ENV="development"
APP_HOST="0.0.0.0"
APP_PORT=8000
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# [4] PostgreSQL 16 데이터베이스 설정 (SQLAlchemy 2.0 AsyncSession)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="remote_pc_web"
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/remote_pc_web"

# [5] Redis 7 인메모리 캐시 및 레이트리밋 설정
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL="redis://localhost:6379/0"

# [6] 관리자 인증 및 보안 설정 (Argon2id / JWT)
SECRET_KEY="change-this-to-a-secure-random-64-byte-hex-string-in-production"
ADMIN_INITIAL_USERNAME="admin"
ADMIN_INITIAL_PASSWORD="ChangeMe123!"
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# [7] 프론트엔드 공개 환경변수
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
NEXT_PUBLIC_DEFAULT_THEME="cyber-hud"

